{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/blob/dev/doc/json_schema.json",
  "logo": {
    "type": "raw",
    "source": "~/.config/fastfetch/laliguras.txt",
    "padding": { "left": 1, "right": 50 }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "separator" },
    { "type": "os" },
    { "type": "host", "name": "Host" },
    { "type": "display" },
    { "type": "de" },
    { "type": "wm" },
    { "type": "theme" },
    { "type": "icons" },
    { "type": "font" },
    { "type": "cursor" },
    { "type": "terminal" },
    { "type": "cpu" },
    { "type": "gpu" },
    { "type": "memory" },
    { "type": "disk" },
    { "type": "battery" },
    { "type": "locale" },
    { "type": "break" }
   
  ]
}
